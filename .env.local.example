# ---------------------------------------------------------------------------
# Supabase — Project Settings -> API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS entirely, so it must never appear in anything
# prefixed NEXT_PUBLIC_ and never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Public site URL. Used to build OAuth redirect callbacks.
# Local:      http://localhost:3000
# Vercel:     https://your-app.vercel.app  (or your custom domain)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Which data the app runs on.
#
# true (or unset) — every read and write in src/lib/api answers from
#   src/lib/feed-mock.ts. No Supabase queries at all on the feed, the profile,
#   settings or onboarding step 3.
# false — the same functions take their Supabase branch. Most of those are not
#   written yet and will throw a named error saying so, which is deliberate:
#   better a loud "getFeedPosts is not wired" than a silently empty feed.
#
# Read in exactly one place, src/lib/config.ts. Components never check it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=true
